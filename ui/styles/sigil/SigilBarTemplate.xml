<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\Blizzard_SharedXML\UI.xsd">

	<!-- XP Bar Enhanced Sigil Template -->
	<!-- A tiered class ring. Progress is a clockwise ARC swept around an annulus
	     channel by paused Cooldown frames (created in SigilBarStyle.lua), per the
	     League-reference read: the arc emerges left of the crest and completes at
	     its right, the crest plate covering the seam. The StatusBar survives only
	     as an alpha-0 data carrier for the mixins (the terminal style's trick);
	     the three repaintable skin layers are unchanged. -->

	<!-- The frame is TALLER than the ring. The class crest seats at 6 o'clock,
	     outside the circle's silhouette, so the frame has to include it for the
	     mouse hit area to cover it. Every circular element is therefore sized and
	     anchored to the ring square at the TOP of the frame, never setAllPoints,
	     and the masks clip the TEXTURES rather than the hit rect. Sizes here are
	     the medium preset; SigilBarStyle:ApplySizePreset re-drives all of them. -->

	<Script file="SigilBarStyle.lua"/>

	<Frame name="SigilBarTemplate" virtual="true" mixin="SigilBarXPBarMixin" frameStrata="LOW" enableMouse="true" fixedFrameStrata="true">
		<Size x="128" y="152"/>
		<Layers>
			<Layer level="BACKGROUND">
				<!-- Dark cavity behind the fill, clipped to the circle -->
				<Texture parentKey="Cavity" file="Interface\Buttons\WHITE8X8">
					<Size x="128" y="128"/>
					<Anchors>
						<Anchor point="TOP"/>
					</Anchors>
					<Color r="0.06" g="0.06" b="0.09" a="0.92"/>
				</Texture>
				<MaskTexture parentKey="CircleMask" file="Interface\CharacterFrame\TempPortraitAlphaMask" hWrapMode="CLAMPTOBLACKADDITIVE" vWrapMode="CLAMPTOBLACKADDITIVE">
					<Size x="128" y="128"/>
					<Anchors>
						<Anchor point="TOP"/>
					</Anchors>
					<MaskedTextures>
						<MaskedTexture childKey="Cavity"/>
					</MaskedTextures>
				</MaskTexture>
			</Layer>
			<Layer level="BORDER">
				<!-- The recessed groove the XP arc runs in. Static: the arc
				     Cooldown frames sweep over it, so an empty channel still
				     shows the reader where progress will go. -->
				<Texture parentKey="ArcTrack" file="Interface\AddOns\XPBarEnhanced\assets\sigil-track" alphaMode="BLEND">
					<Size x="128" y="128"/>
					<Anchors>
						<Anchor point="TOP"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="OVERLAY" textureSubLevel="2">
				<!-- Gain flash. The annulus texture, so the flash pulses the arc
				     channel rather than the whole disc. -->
				<Texture parentKey="GainFlash" hidden="true" alphaMode="BLEND" file="Interface\AddOns\XPBarEnhanced\assets\sigil-fill">
					<Size x="128" y="128"/>
					<Anchors>
						<Anchor point="TOP"/>
					</Anchors>
					<Color r="1" g="1" b="1" a="0"/>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<!-- Alpha-0 data carrier: the mixins read and write StatusBar values,
			     and the arc frames render the visual. Its fill texture is hidden
			     in OnLoad; quest/rested visuals are arc layers created there too. -->
			<StatusBar parentKey="StatusBar" minValue="0" maxValue="1" defaultValue="0" orientation="VERTICAL">
				<Size x="128" y="128"/>
				<Anchors>
					<Anchor point="TOP"/>
				</Anchors>
				<BarTexture file="Interface\Buttons\WHITE8X8"/>
			</StatusBar>

			<!-- Everything that draws OVER the fill. A single child frame, so the
			     skin layers and the readout all sit above the StatusBar; their
			     relative order is carried by the draw layers within it, matching
			     the design's ART 2 / OVR 0 / OVR 1 / OVR 2 stack.

			     Keeping the readout in a container is also what lets the whole
			     three-row block scale as one unit. It covers the full frame so the
			     crest can live at the bottom, and the FontStrings are re-anchored
			     to the RING centre by ApplySizePreset, not to the taller frame. -->
			<Frame parentKey="OverlayFrameTextContainer" frameStrata="MEDIUM" setAllPoints="true">
				<Layers>
					<!-- The casing carries the tier signal alone (the per-class
					     rune band was removed 2026-08-16: repeated marks read
					     as noise, and the reference escalates the frame itself).
					     The procedural halo draws its arcs, ticks and bloom into
					     pooled textures created at runtime on this container. -->
					<Layer level="BORDER">
						<Texture parentKey="SkinFrame" hidden="true" alphaMode="BLEND">
							<Size x="128" y="128"/>
							<Anchors>
								<Anchor point="TOP"/>
							</Anchors>
						</Texture>
					</Layer>
					<!-- Class mark at 6 o'clock; hidden when the skin declares none.
					     The one skin element that is not radially symmetric. -->
					<Layer level="ARTWORK">
						<Texture parentKey="Crest" hidden="true" alphaMode="BLEND">
							<Size x="44" y="44"/>
							<Anchors>
								<Anchor point="BOTTOM"/>
							</Anchors>
						</Texture>
					</Layer>
					<Layer level="OVERLAY">
						<FontString parentKey="LevelText" inherits="GameFontNormalLarge" hidden="true">
							<Anchors>
								<Anchor point="CENTER" x="0" y="27"/>
							</Anchors>
							<Color r="1.0" g="1.0" b="1.0"/>
							<Shadow>
								<Offset x="1" y="-1"/>
								<Color r="0" g="0" b="0" a="0.8"/>
							</Shadow>
						</FontString>
						<FontString parentKey="PercentText" inherits="GameFontNormal" hidden="true">
							<Anchors>
								<Anchor point="CENTER" x="0" y="8"/>
							</Anchors>
							<Color r="1.0" g="1.0" b="1.0"/>
							<Shadow>
								<Offset x="1" y="-1"/>
								<Color r="0" g="0" b="0" a="0.8"/>
							</Shadow>
						</FontString>
						<FontString parentKey="RateText" inherits="GameFontNormalSmall" hidden="true">
							<Anchors>
								<Anchor point="CENTER" x="0" y="-10"/>
							</Anchors>
							<Color r="1.0" g="1.0" b="1.0"/>
							<Shadow>
								<Offset x="1" y="-1"/>
								<Color r="0" g="0" b="0" a="0.8"/>
							</Shadow>
						</FontString>
					</Layer>
				</Layers>
			</Frame>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnShow method="OnShow"/>
			<OnHide method="OnHide"/>
			<OnEvent method="OnEvent"/>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
			<OnMouseDown method="OnMouseDown"/>
			<OnMouseUp method="OnMouseUp"/>
		</Scripts>
	</Frame>
</Ui>
