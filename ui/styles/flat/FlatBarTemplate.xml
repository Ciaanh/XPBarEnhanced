<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\Blizzard_SharedXML\UI.xsd">

	<!-- XP Bar Enhanced - FlatBar Template  -->
	<!-- Inherits BelowBarTextContainer and script handlers from XPBarBaseTemplate -->

	<Script file="FlatBarStyle.lua"/>

	<Frame name="FlatBarTemplate" virtual="true" inherits="XPBarBaseTemplate" mixin="FlatBarXPBarMixin">
		<Size x="565" y="30"/>
		<Layers>
			<!-- Background layer -->
			<Layer level="BACKGROUND" textureSubLevel="1">
				<Texture parentKey="Background" setAllPoints="true">
					<Color r="0" g="0" b="0" a="0.5"/>
				</Texture>
			</Layer>

			<!-- Flash effect overlay -->
			<Layer level="OVERLAY" textureSubLevel="3">
				<Texture parentKey="GainFlash" hidden="true" alphaMode="BLEND">
					<Anchors>
						<Anchor point="TOPLEFT"/>
						<Anchor point="BOTTOMRIGHT"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<!-- XP StatusBar (solid color, no texture atlas) -->
			<StatusBar parentKey="StatusBar" minValue="0" maxValue="1" defaultValue="0">
				<Size x="565" y="30"/>
				<Anchors>
					<Anchor point="CENTER" x="0" y="0"/>
				</Anchors>
				<BarColor r="0.58" g="0.0" b="0.55"/>
				<BarTexture file="Interface\Buttons\WHITE8X8"/>
				<Layers>
					<!-- Rested XP overlay -->
					<Layer level="BACKGROUND" textureSubLevel="-1">
						<Texture parentKey="RestedOverlay" hidden="true" file="Interface\Buttons\WHITE8X8">
							<Size x="0" y="30"/>
							<Anchors>
								<Anchor point="BOTTOMLEFT" relativeKey="$parent" relativePoint="BOTTOMLEFT" x="0" y="0"/>
							</Anchors>
							<Color r="0.07" g="0.58" b="0.95" a="0.5"/>
						</Texture>
					</Layer>

					<!-- Quest overlay - complete quests -->
					<Layer level="ARTWORK" textureSubLevel="1">
						<Texture parentKey="QuestOverlayComplete" hidden="true" file="Interface\Buttons\WHITE8X8">
							<Size x="0" y="30"/>
							<Anchors>
								<Anchor point="BOTTOMLEFT" x="0" y="0"/>
							</Anchors>
							<Color r="1.0" g="0.65" b="0.0" a="0.85"/>
						</Texture>
					</Layer>

					<!-- Quest overlay - incomplete quests -->
					<Layer level="ARTWORK" textureSubLevel="2">
						<Texture parentKey="QuestOverlayIncomplete" hidden="true" file="Interface\Buttons\WHITE8X8">
							<Size x="0" y="30"/>
							<Anchors>
								<Anchor point="BOTTOMLEFT" x="0" y="0"/>
							</Anchors>
							<Color r="0.5" g="1.0" b="0.2" a="0.85"/>
						</Texture>
					</Layer>
				</Layers>
			</StatusBar>

			<!-- On-bar text container (style-specific: uses TextStatusBarTextLarge) -->
			<Frame parentKey="OverlayFrameTextContainer" frameStrata="MEDIUM" setAllPoints="true">
				<Layers>
					<Layer level="ARTWORK" textureSubLevel="5">
						<FontString parentKey="LevelText" inherits="TextStatusBarTextLarge" hidden="true">
							<Anchors>
								<Anchor point="LEFT" x="8" y="0"/>
							</Anchors>
							<Color r="1.0" g="1.0" b="1.0"/>
							<Shadow>
								<Offset x="2" y="-2"/>
								<Color r="0" g="0" b="0" a="0.8"/>
							</Shadow>
						</FontString>

						<FontString parentKey="XPText" inherits="TextStatusBarTextLarge" hidden="true">
							<Anchors>
								<Anchor point="CENTER" x="0" y="0"/>
							</Anchors>
							<Color r="1.0" g="1.0" b="1.0"/>
							<Shadow>
								<Offset x="2" y="-2"/>
								<Color r="0" g="0" b="0" a="0.8"/>
							</Shadow>
						</FontString>

						<FontString parentKey="PercentText" inherits="TextStatusBarTextLarge" hidden="true">
							<Anchors>
								<Anchor point="RIGHT" x="-8" y="0"/>
							</Anchors>
							<Color r="1.0" g="1.0" b="1.0"/>
							<Shadow>
								<Offset x="2" y="-2"/>
								<Color r="0" g="0" b="0" a="0.8"/>
							</Shadow>
						</FontString>
					</Layer>
				</Layers>
			</Frame>
		</Frames>
	</Frame>

</Ui>
