<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\Blizzard_SharedXML\UI.xsd">

    <!-- XP Bar Enhanced - Ring Secondary Bar Template -->
    <!-- A concentric band built by RingSecondaryBarStyle.lua: its size follows
         the Ring options and the secondary placement. -->

    <Script file="RingSecondaryBarStyle.lua"/>

    <Frame name="RingReputationBarTemplate" virtual="true" mixin="XPBarRingReputationMixin" frameStrata="MEDIUM" fixedFrameStrata="true" enableMouse="true">
        <Size x="104" y="104"/>
        <Scripts>
            <OnLoad method="OnLoad"/>
            <OnShow method="OnShow"/>
            <OnHide method="OnHide"/>
            <OnEnter method="OnEnter"/>
            <OnLeave method="OnLeave"/>
            <OnMouseUp method="OnMouseUp"/>
            <OnDragStart method="OnDragStart"/>
            <OnDragStop method="OnDragStop"/>
        </Scripts>
    </Frame>

</Ui>
