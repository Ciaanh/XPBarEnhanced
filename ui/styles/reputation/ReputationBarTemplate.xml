<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\Blizzard_SharedXML\UI.xsd">

	<!-- XP Bar Enhanced - Reputation Bar Template -->
	<!-- Reuses FlatBar visual structure for reputation display -->

	<Script file="ReputationBarStyle.lua"/>

	<Frame name="ReputationBarTemplate" virtual="true" mixin="ReputationBarXPBarMixin" frameStrata="LOW" enableMouse="true" fixedFrameStrata="true">
		<Size x="565" y="30"/>
		<Layers>
			<!-- Background layer -->
			<Layer level="BACKGROUND" textureSubLevel="1">
				<Texture parentKey="Background" setAllPoints="true">
					<Color r="0" g="0" b="0" a="0.5"/>
				</Texture>
			</Layer>

			<!-- Flash effect overlay -->
			<Layer level="OVERLAY" textureSubLevel="3">
				<Texture parentKey="GainFlash" hidden="true" alphaMode="BLEND">
					<Anchors>
						<Anchor point="TOPLEFT"/>
						<Anchor point="BOTTOMRIGHT"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<!-- Reputation StatusBar (solid color, standing-based) -->
			<StatusBar parentKey="StatusBar" minValue="0" maxValue="1" defaultValue="0">
				<Size x="565" y="30"/>
				<Anchors>
					<Anchor point="CENTER" x="0" y="0"/>
				</Anchors>
				<!-- Default neutral yellow color (overridden at runtime by standing color) -->
				<BarColor r="0.76" g="0.70" b="0.30"/>
				<BarTexture file="Interface\Buttons\WHITE8X8"/>
				<Layers>
					<!-- No rested/quest overlays needed for reputation -->
				</Layers>
			</StatusBar>

			<!-- Overlay frame for ON-BAR text -->
			<Frame parentKey="OverlayFrameTextContainer" frameStrata="MEDIUM" setAllPoints="true">
				<Layers>
					<Layer level="ARTWORK" textureSubLevel="5">
						<!-- Standing text - left side -->
						<FontString parentKey="LevelText" inherits="TextStatusBarTextLarge" hidden="true">
							<Anchors>
								<Anchor point="LEFT" x="8" y="0"/>
							</Anchors>
							<Color r="1.0" g="1.0" b="1.0"/>
							<Shadow>
								<Offset x="2" y="-2"/>
								<Color r="0" g="0" b="0" a="0.8"/>
							</Shadow>
						</FontString>

						<!-- Rep amounts text - center -->
						<FontString parentKey="XPText" inherits="TextStatusBarTextLarge" hidden="true">
							<Anchors>
								<Anchor point="CENTER" x="0" y="0"/>
							</Anchors>
							<Color r="1.0" g="1.0" b="1.0"/>
							<Shadow>
								<Offset x="2" y="-2"/>
								<Color r="0" g="0" b="0" a="0.8"/>
							</Shadow>
						</FontString>

						<!-- Percent text - right side -->
						<FontString parentKey="PercentText" inherits="TextStatusBarTextLarge" hidden="true">
							<Anchors>
								<Anchor point="RIGHT" x="-8" y="0"/>
							</Anchors>
							<Color r="1.0" g="1.0" b="1.0"/>
							<Shadow>
								<Offset x="2" y="-2"/>
								<Color r="0" g="0" b="0" a="0.8"/>
							</Shadow>
						</FontString>
					</Layer>
				</Layers>
			</Frame>

			<!-- BELOW-BAR text container -->
			<Frame parentKey="BelowBarTextContainer" frameStrata="MEDIUM">
				<Size x="565" y="30"/>
				<Anchors>
					<Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT" x="0" y="-2"/>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<!-- Faction name - below bar on left -->
						<FontString parentKey="RateText" inherits="GameFontNormal" hidden="true">
							<Anchors>
								<Anchor point="TOPLEFT" x="0" y="0"/>
							</Anchors>
							<Color r="0.8" g="0.8" b="0.8"/>
						</FontString>

						<!-- Session text (unused for reputation) -->
						<FontString parentKey="SessionText" inherits="GameFontNormal" hidden="true">
							<Anchors>
								<Anchor point="TOPRIGHT" x="0" y="0"/>
							</Anchors>
							<Color r="0.8" g="0.8" b="0.8"/>
						</FontString>

						<!-- Quest summary text (unused for reputation) -->
						<FontString parentKey="QuestSummaryText" inherits="GameFontNormal" hidden="true">
							<Anchors>
								<Anchor point="TOP" x="0" y="-12"/>
							</Anchors>
							<Color r="0.8" g="0.8" b="0.8"/>
						</FontString>
					</Layer>
				</Layers>
			</Frame>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnEvent method="OnEvent"/>
			<OnShow method="OnShow"/>
			<OnHide method="OnHide"/>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
			<OnMouseDown method="OnMouseDown"/>
			<OnMouseUp method="OnMouseUp"/>
		</Scripts>
	</Frame>

</Ui>
