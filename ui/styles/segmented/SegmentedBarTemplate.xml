<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\Blizzard_SharedXML\UI.xsd">

	<!-- XP Bar Enhanced - Segmented Bar Template -->
	<!-- Discrete segment visualization of XP progress -->

	<Script file="SegmentedBarStyle.lua"/>

	<Frame name="SegmentedBarTemplate" virtual="true" mixin="SegmentedBarXPBarMixin" frameStrata="LOW" enableMouse="true" fixedFrameStrata="true">
		<Size x="565" y="24"/>
		<Layers>
			<!-- Background layer -->
			<Layer level="BACKGROUND" textureSubLevel="0">
				<Texture parentKey="Background" setAllPoints="true">
					<Color r="0.05" g="0.05" b="0.05" a="0.7"/>
				</Texture>
			</Layer>

			<!-- Flash effect overlay -->
			<Layer level="OVERLAY" textureSubLevel="3">
				<Texture parentKey="GainFlash" hidden="true" alphaMode="BLEND">
					<Anchors>
						<Anchor point="TOPLEFT"/>
						<Anchor point="BOTTOMRIGHT"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<!-- Hidden StatusBar for mixin compatibility (ratio tracking, animation system) -->
			<StatusBar parentKey="StatusBar" minValue="0" maxValue="1" defaultValue="0" alpha="0">
				<Size x="565" y="24"/>
				<Anchors>
					<Anchor point="CENTER" x="0" y="0"/>
				</Anchors>
				<BarColor r="0.58" g="0.0" b="0.55"/>
				<BarTexture file="Interface\Buttons\WHITE8X8"/>
				<Layers>
					<!-- Hidden overlays for mixin compatibility -->
					<Layer level="BACKGROUND" textureSubLevel="-1">
						<Texture parentKey="RestedOverlay" hidden="true" file="Interface\Buttons\WHITE8X8">
							<Size x="0" y="24"/>
							<Anchors>
								<Anchor point="BOTTOMLEFT" x="0" y="0"/>
							</Anchors>
						</Texture>
					</Layer>
					<Layer level="ARTWORK" textureSubLevel="1">
						<Texture parentKey="QuestOverlayComplete" hidden="true" file="Interface\Buttons\WHITE8X8">
							<Size x="0" y="24"/>
							<Anchors>
								<Anchor point="BOTTOMLEFT" x="0" y="0"/>
							</Anchors>
						</Texture>
					</Layer>
					<Layer level="ARTWORK" textureSubLevel="2">
						<Texture parentKey="QuestOverlayIncomplete" hidden="true" file="Interface\Buttons\WHITE8X8">
							<Size x="0" y="24"/>
							<Anchors>
								<Anchor point="BOTTOMLEFT" x="0" y="0"/>
							</Anchors>
						</Texture>
					</Layer>
				</Layers>
			</StatusBar>

			<!-- Segment container - segments created in Lua -->
			<Frame parentKey="SegmentContainer" setAllPoints="true">
				<Anchors>
					<Anchor point="TOPLEFT" x="0" y="0"/>
					<Anchor point="BOTTOMRIGHT" x="0" y="0"/>
				</Anchors>
			</Frame>

			<!-- Overlay frame for ON-BAR text (separate from StatusBar for proper layering) -->
			<Frame parentKey="OverlayFrameTextContainer" frameStrata="MEDIUM" setAllPoints="true">
				<Layers>
					<Layer level="ARTWORK" textureSubLevel="5">
						<!-- Level text - left side -->
						<FontString parentKey="LevelText" inherits="TextStatusBarTextLarge" hidden="true">
							<Anchors>
								<Anchor point="LEFT" x="8" y="0"/>
							</Anchors>
							<Color r="1.0" g="1.0" b="1.0"/>
							<Shadow>
								<Offset x="2" y="-2"/>
								<Color r="0" g="0" b="0" a="0.8"/>
							</Shadow>
						</FontString>

						<!-- XP text - center -->
						<FontString parentKey="XPText" inherits="TextStatusBarTextLarge" hidden="true">
							<Anchors>
								<Anchor point="CENTER" x="0" y="0"/>
							</Anchors>
							<Color r="1.0" g="1.0" b="1.0"/>
							<Shadow>
								<Offset x="2" y="-2"/>
								<Color r="0" g="0" b="0" a="0.8"/>
							</Shadow>
						</FontString>

						<!-- Percent text - right side -->
						<FontString parentKey="PercentText" inherits="TextStatusBarTextLarge" hidden="true">
							<Anchors>
								<Anchor point="RIGHT" x="-8" y="0"/>
							</Anchors>
							<Color r="1.0" g="1.0" b="1.0"/>
							<Shadow>
								<Offset x="2" y="-2"/>
								<Color r="0" g="0" b="0" a="0.8"/>
							</Shadow>
						</FontString>
					</Layer>
				</Layers>
			</Frame>

			<!-- BELOW-BAR text container -->
			<Frame parentKey="BelowBarTextContainer" frameStrata="MEDIUM">
				<Size x="565" y="30"/>
				<Anchors>
					<Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT" x="0" y="-2"/>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<FontString parentKey="RateText" inherits="GameFontNormal" hidden="true">
							<Anchors>
								<Anchor point="TOPLEFT" x="0" y="0"/>
							</Anchors>
							<Color r="0.8" g="0.8" b="0.8"/>
						</FontString>
						<FontString parentKey="SessionText" inherits="GameFontNormal" hidden="true">
							<Anchors>
								<Anchor point="TOPRIGHT" x="0" y="0"/>
							</Anchors>
							<Color r="0.8" g="0.8" b="0.8"/>
						</FontString>
						<FontString parentKey="QuestSummaryText" inherits="GameFontNormal" hidden="true">
							<Anchors>
								<Anchor point="TOP" x="0" y="-12"/>
							</Anchors>
							<Color r="0.8" g="0.8" b="0.8"/>
						</FontString>
					</Layer>
				</Layers>
			</Frame>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnEvent method="OnEvent"/>
			<OnShow method="OnShow"/>
			<OnHide method="OnHide"/>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
			<OnMouseDown method="OnMouseDown"/>
			<OnMouseUp method="OnMouseUp"/>
		</Scripts>
	</Frame>

</Ui>
