<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\Blizzard_SharedXML\UI.xsd">

	<!-- XP Bar Enhanced - Orb Template -->
	<!-- Circular orb filling vertically: VERTICAL StatusBar under a circle mask -->

	<Script file="OrbBarStyle.lua"/>

	<Frame name="OrbBarTemplate" virtual="true" mixin="OrbBarXPBarMixin" frameStrata="LOW" enableMouse="true" fixedFrameStrata="true">
		<Size x="110" y="110"/>
		<Layers>
			<Layer level="BACKGROUND">
				<!-- Dark orb disc, clipped to the circle mask -->
				<Texture parentKey="Background" file="Interface\Buttons\WHITE8X8" setAllPoints="true">
					<Color r="0.07" g="0.07" b="0.10" a="0.92"/>
				</Texture>
				<MaskTexture parentKey="CircleMask" file="Interface\CharacterFrame\TempPortraitAlphaMask" hWrapMode="CLAMPTOBLACKADDITIVE" vWrapMode="CLAMPTOBLACKADDITIVE" setAllPoints="true">
					<MaskedTextures>
						<MaskedTexture childKey="Background"/>
					</MaskedTextures>
				</MaskTexture>
			</Layer>
			<Layer level="OVERLAY" textureSubLevel="2">
				<!-- Gain flash, clipped at runtime with the fill mask -->
				<Texture parentKey="GainFlash" hidden="true" alphaMode="BLEND" file="Interface\Buttons\WHITE8X8" setAllPoints="true">
					<Color r="1" g="1" b="1" a="0"/>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<!-- XP StatusBar (vertical orientation; fill masked in OnLoad) -->
			<StatusBar parentKey="StatusBar" minValue="0" maxValue="1" defaultValue="0" orientation="VERTICAL" setAllPoints="true">
				<BarTexture file="Interface\Buttons\WHITE8X8"/>
			</StatusBar>

			<!-- Overlay frame for centered text -->
			<Frame parentKey="OverlayFrameTextContainer" frameStrata="MEDIUM" setAllPoints="true">
				<Layers>
					<Layer level="OVERLAY">
						<FontString parentKey="LevelText" inherits="GameFontNormalLarge" hidden="true">
							<Anchors>
								<Anchor point="CENTER" x="0" y="12"/>
							</Anchors>
						</FontString>
						<FontString parentKey="PercentText" inherits="GameFontNormal" hidden="true">
							<Anchors>
								<Anchor point="CENTER" x="0" y="-12"/>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
			</Frame>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnShow method="OnShow"/>
			<OnHide method="OnHide"/>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
		</Scripts>
	</Frame>
</Ui>
