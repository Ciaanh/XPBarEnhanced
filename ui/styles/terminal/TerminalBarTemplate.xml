<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\Blizzard_SharedXML\UI.xsd">

	<!-- XP Bar Enhanced - Terminal Bar Template (Easter Egg) -->
	<!-- Unified two-line display: progress bar + stats prompt on a single background -->

	<Script file="TerminalBarStyle.lua"/>

	<Frame name="TerminalBarTemplate" virtual="true" mixin="TerminalBarXPBarMixin" frameStrata="LOW" enableMouse="true" fixedFrameStrata="true">
		<Size x="650" y="42"/>
		<Layers>
			<!-- Near-black terminal background covering both lines -->
			<Layer level="BACKGROUND" textureSubLevel="0">
				<Texture parentKey="Background" setAllPoints="true">
					<Color r="0.02" g="0.02" b="0.02" a="0.92"/>
				</Texture>
			</Layer>

			<!-- Hidden GainFlash (kept for mixin contract) -->
			<Layer level="OVERLAY" textureSubLevel="3">
				<Texture parentKey="GainFlash" hidden="true" alphaMode="BLEND">
					<Anchors>
						<Anchor point="TOPLEFT"/>
						<Anchor point="BOTTOMRIGHT"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<!-- Hidden StatusBar for mixin compatibility -->
			<StatusBar parentKey="StatusBar" minValue="0" maxValue="1" defaultValue="0" alpha="0">
				<Size x="650" y="42"/>
				<Anchors>
					<Anchor point="CENTER" x="0" y="0"/>
				</Anchors>
				<BarColor r="0" g="1" b="0"/>
				<BarTexture file="Interface\Buttons\WHITE8X8"/>
				<Layers>
					<Layer level="BACKGROUND" textureSubLevel="-1">
						<Texture parentKey="RestedOverlay" hidden="true" file="Interface\Buttons\WHITE8X8">
							<Size x="0" y="42"/>
							<Anchors>
								<Anchor point="BOTTOMLEFT" x="0" y="0"/>
							</Anchors>
						</Texture>
					</Layer>
					<Layer level="ARTWORK" textureSubLevel="1">
						<Texture parentKey="QuestOverlayComplete" hidden="true" file="Interface\Buttons\WHITE8X8">
							<Size x="0" y="42"/>
							<Anchors>
								<Anchor point="BOTTOMLEFT" x="0" y="0"/>
							</Anchors>
						</Texture>
					</Layer>
					<Layer level="ARTWORK" textureSubLevel="2">
						<Texture parentKey="QuestOverlayIncomplete" hidden="true" file="Interface\Buttons\WHITE8X8">
							<Size x="0" y="42"/>
							<Anchors>
								<Anchor point="BOTTOMLEFT" x="0" y="0"/>
							</Anchors>
						</Texture>
					</Layer>
				</Layers>
			</StatusBar>

			<!-- Unified text layer: bar line + stats line + delta popup, all on one background -->
			<Frame parentKey="OverlayFrameTextContainer" frameStrata="MEDIUM" setAllPoints="true">
				<Layers>
					<Layer level="ARTWORK" textureSubLevel="5">

						<!-- Line 1: coloured block progress bar (left-anchored, grows rightward) -->
						<FontString parentKey="TerminalBarText" inherits="GameFontHighlightSmall">
							<Anchors>
								<Anchor point="TOPLEFT" x="8" y="-8"/>
							</Anchors>
						</FontString>

						<!-- Line 1 label: percentage + level (right-anchored with consistent padding) -->
						<FontString parentKey="TerminalLabelText" inherits="GameFontHighlightSmall" justifyH="RIGHT">
							<Anchors>
								<Anchor point="TOPRIGHT" x="-8" y="-8"/>
							</Anchors>
						</FontString>

						<!-- Line 2: stats prompt  > xp/hr:44K | eta:9h31m | ... -->
						<FontString parentKey="TerminalStatsText" inherits="GameFontNormalSmall" hidden="true">
							<Anchors>
								<Anchor point="BOTTOMLEFT" x="8" y="4"/>
							</Anchors>
						</FontString>

						<!-- XP delta popup: "+465 XP" fades in then out on gain (positioned above, no overlap) -->
						<FontString parentKey="DeltaText" inherits="GameFontNormalSmall" hidden="true">
							<Anchors>
								<Anchor point="BOTTOMRIGHT" x="-4" y="4"/>
							</Anchors>
						</FontString>

						<!-- Standard text stubs kept for TextMixin compatibility (always hidden) -->
						<FontString parentKey="LevelText" inherits="TextStatusBarTextLarge" hidden="true">
							<Anchors>
								<Anchor point="LEFT" x="8" y="0"/>
							</Anchors>
						</FontString>
						<FontString parentKey="XPText" inherits="TextStatusBarTextLarge" hidden="true">
							<Anchors>
								<Anchor point="CENTER" x="0" y="0"/>
							</Anchors>
						</FontString>
						<FontString parentKey="PercentText" inherits="TextStatusBarTextLarge" hidden="true">
							<Anchors>
								<Anchor point="RIGHT" x="-8" y="0"/>
							</Anchors>
						</FontString>

					</Layer>
				</Layers>
			</Frame>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnEvent method="OnEvent"/>
			<OnShow method="OnShow"/>
			<OnHide method="OnHide"/>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
			<OnMouseDown method="OnMouseDown"/>
			<OnMouseUp method="OnMouseUp"/>
		</Scripts>
	</Frame>

</Ui>
