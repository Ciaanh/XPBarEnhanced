<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\Blizzard_SharedXML\UI.xsd">

    <!-- XP Bar Enhanced - Vertical Secondary Bar Template -->
    <!-- Slim 20x300 vertical reputation bar alongside the vertical primary column. -->
    <!-- Tooltip-only: no on-bar label (frame is too narrow for readable text). -->

    <Script file="VerticalSecondaryBarStyle.lua"/>

    <Frame name="VerticalReputationBarTemplate" virtual="true" mixin="XPBarVerticalReputationMixin" frameStrata="MEDIUM" fixedFrameStrata="true" enableMouse="true">
        <Size x="20" y="300"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="Background" setAllPoints="true">
                    <Color r="0" g="0" b="0" a="0.5"/>
                </Texture>
            </Layer>
        </Layers>
        <Frames>
            <!-- Vertical StatusBar fills upward from bottom as reputation increases -->
            <StatusBar parentKey="Bar" minValue="0" maxValue="1" defaultValue="0" orientation="VERTICAL">
                <Size x="20" y="300"/>
                <Anchors>
                    <Anchor point="TOPLEFT"/>
                </Anchors>
                <BarTexture file="Interface\Buttons\WHITE8X8"/>
            </StatusBar>
        </Frames>
        <Scripts>
            <OnLoad method="OnLoad"/>
            <OnShow method="OnShow"/>
            <OnHide method="OnHide"/>
            <OnEnter method="OnEnter"/>
            <OnLeave method="OnLeave"/>
            <OnMouseUp method="OnMouseUp"/>
            <OnDragStart method="OnDragStart"/>
            <OnDragStop method="OnDragStop"/>
        </Scripts>
    </Frame>

</Ui>
