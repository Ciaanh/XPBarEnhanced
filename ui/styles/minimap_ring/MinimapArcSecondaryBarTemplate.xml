<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\Blizzard_SharedXML\UI.xsd">

    <!-- XP Bar Enhanced - Minimap Arc Secondary Bar Template -->

    <Script file="MinimapArcSecondaryBarStyle.lua"/>

    <Frame name="MinimapArcReputationBarTemplate" virtual="true" mixin="XPBarMinimapArcReputationMixin" frameStrata="MEDIUM" fixedFrameStrata="true" frameLevel="8" fixedFrameLevel="true" enableMouse="true">
        <Size x="31" y="31"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="IconBackground" file="Interface\Minimap\UI-Minimap-Background">
                    <Size x="20" y="20"/>
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                    <Color r="0.08" g="0.08" b="0.08" a="0.55"/>
                </Texture>
            </Layer>
            <Layer level="ARTWORK" textureSubLevel="2">
                <Texture parentKey="IconTexture" file="Interface\Minimap\Minimap_shield_normal">
                    <Size x="18" y="18"/>
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                    <Color r="1.0" g="1.0" b="1.0" a="1.0"/>
                </Texture>
            </Layer>
        </Layers>
        <Frames>
            <Frame parentKey="ArcFrame" enableMouse="false" hidden="true" frameStrata="MEDIUM" fixedFrameStrata="true" frameLevel="6" fixedFrameLevel="true">
                <Size x="128" y="128"/>
                <Anchors>
                    <Anchor point="CENTER"/>
                </Anchors>
            </Frame>
        </Frames>
        <Scripts>
            <OnLoad method="OnLoad"/>
            <OnShow method="OnShow"/>
            <OnHide method="OnHide"/>
            <OnEnter method="OnEnter"/>
            <OnLeave method="OnLeave"/>
            <OnMouseUp method="OnMouseUp"/>
            <OnDragStart method="OnDragStart"/>
            <OnDragStop method="OnDragStop"/>
        </Scripts>
    </Frame>

</Ui>
