                                    <!-- ==================== Bar Settings ==================== -->

                                    <Frame parentKey="BarSettingsHeader" inherits="ConfigSectionHeader">
                                        <KeyValues>
                                            <KeyValue key="layoutIndex" value="1" type="number"/>
                                            <KeyValue key="expand" value="true" type="boolean"/>
                                            <KeyValue key="leftPadding" value="12" type="number"/>
                                        </KeyValues>
                                    </Frame>

                                    <Frame parentKey="Row_barStyle" inherits="ConfigDropdownTemplate">
                                        <KeyValues>
                                            <KeyValue key="configKey" value="barStyle" type="string"/>
                                            <KeyValue key="layoutIndex" value="2" type="number"/>
