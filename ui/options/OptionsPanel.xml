                            <Anchor point="TOPLEFT"/>
                        </Anchors>
                        <Layers>
                            <Layer level="ARTWORK">
                                <FontString parentKey="TitleText" inherits="GameFontNormalLarge">
                                    <Anchors>
                                        <Anchor point="TOPLEFT" x="16" y="-16"/>
                                    </Anchors>
                                </FontString>
                                <FontString parentKey="SubtitleText" inherits="GameFontHighlightSmall">
