                                    </Anchors>
                                    <Size x="520" y="0"/>
                                </FontString>
                            </Layer>
                        </Layers>
                        <Frames>
                            <!--
                                OptionsContainer uses VerticalLayoutMixin (applied in Options.lua:OnLoad).
                                Children declare layoutIndex so the mixin stacks them top-to-bottom,
                                skipping hidden frames automatically — no manual anchor chains needed.
                                Per-child attributes:
                                  layoutIndex  – stacking order (required)
                                  expand       – fill container width (replaces Anchor RIGHT)
                                  topPadding   – extra space before this child (replaces negative y offset)
                                  leftPadding  – left indent (replaces positive x offset)
                            -->
                            <Frame parentKey="OptionsContainer">
                                <Anchors>
                                    <Anchor point="TOPLEFT" relativeKey="$parent.SubtitleText" relativePoint="BOTTOMLEFT" x="0" y="-12"/>
                                </Anchors>
                                <Size x="520" y="1750"/>
