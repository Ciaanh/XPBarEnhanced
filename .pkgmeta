package-as: XPBarEnhanced
enable-nolib-creation: no

manual-changelog: CHANGELOG.md

# Keep in sync with make-release.ps1's $includes: ship only the TOC, XPBarEnhanced.lua, LICENSE,
# README.md, core/, fonts/, libs/, locales/, ui/ and the files at the root of assets/.
#
# The two mechanisms are opposites -- this is a blacklist, $includes is a whitelist -- so a new
# top-level file is shipped by this one by default and dropped by that one. Everything $includes
# omits is listed here. Dotfiles and dot-directories (.github, .gitattributes, ...) are skipped by
# the packager on its own.
ignore:
    - images
    - assets/raw
    - CHANGELOG.md
    - CLASSIC-BAR-CHANGES.md
    - HANDOFF.md
    - CLAUDE.md
    - make-release.ps1
