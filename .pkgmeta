package-as: XPBarEnhanced
enable-nolib-creation: no

manual-changelog: CHANGELOG.md

# Keep in sync with make-release.ps1's whitelist: ship only the TOC/lua,
# LICENSE, README, core/fonts/libs/locales/ui, and assets root files.
#
# The two mechanisms are opposites -- this is a blacklist, make-release.ps1 is a
# whitelist -- so anything added at the top level is shipped by this file by
# default and dropped by that one. Everything the whitelist omits is therefore
# listed here explicitly, including the dot-directories: .github alone is ~990 KB
# of agent and API-reference markdown, larger than the addon it would ride along
# with, and .claude/settings.local.json is local editor state.
ignore:
    - refs
    - .build
    - images
    - assets/raw
    - ROADMAP.md
    - CLAUDE.md
    - CHANGELOG.md
    - make-release.ps1
    - .github
    - .claude
    - .gitignore
